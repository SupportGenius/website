# Cloudflare Pages response headers.
# CSS and JS are referenced with a ?v=<content hash> stamped by
# tools/build-dist.sh, so the URL changes whenever the file does.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://*.cloudflarestream.com; media-src 'self' blob: https://*.cloudflarestream.com; connect-src 'self' https://api.supportgeni.us https://*.cloudflarestream.com; frame-src https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.svg
  Cache-Control: public, max-age=604800

# The film: large, rarely changes. A day, not immutable, so a re-cut film is
# picked up without a URL change. When Stream is in use, its hosts are allowed
# above; tools/stream-upload.sh narrows the wildcard to the customer host.
# Typefaces: named with their version (geist-v1.8.1-latin.woff2), so a changed
# file gets a new name and the immutable cache is safe.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/films/*
  Cache-Control: public, max-age=86400

/assets/films/*.mp4
  Content-Type: video/mp4

# The Stream manifest: small, changes when the owner re-uploads a film.
/assets/films/stream.json
  Cache-Control: public, max-age=300

# PNGs keep their filenames when regenerated, so a week, not immutable.
/assets/*.png
  Cache-Control: public, max-age=604800

/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
